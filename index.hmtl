  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Data House — Portal de Relatórios</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0f141c;
      --panel: #19212d;
      --panel-soft: #202a38;
      --line: rgba(255,255,255,.10);
      --muted: #aab5c6;
      --gold: #f5a34b;
    }
    html { scroll-behavior: smooth; }
    body { margin: 0; font-family: "DM Sans", sans-serif; color: #f8fafc; overflow-x: hidden; }
    .portal-shell {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      background: radial-gradient(circle at 12% 8%, rgba(245,163,75,.16), transparent 28%), radial-gradient(circle at 88% 22%, rgba(49,202,190,.11), transparent 26%), #0f141c;
    }
    .star-field {
      background-image: radial-gradient(rgba(255,255,255,.45) 1px, transparent 1px), radial-gradient(rgba(255,255,255,.22) 1px, transparent 1px);
      background-position: 0 0, 19px 29px;
      background-size: 46px 46px, 71px 71px;
      opacity: .28;
    }
    .display-font { font-family: "Fraunces", serif; }
    .glass-panel { background: rgba(25,33,45,.84); border: 1px solid var(--line); box-shadow: 0 18px 50px rgba(0,0,0,.22); backdrop-filter: blur(14px); }
    .focus-ring:focus-visible { outline: 3px solid #f5a34b; outline-offset: 3px; }
    .model-card { transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease; }
    .model-card:hover { transform: translateY(-5px); border-color: rgba(245,163,75,.7); background: rgba(40,52,69,.96); box-shadow: 0 16px 30px rgba(0,0,0,.24); }
    .house-card { position: relative; overflow: hidden; }
    .house-card::after { content:""; position:absolute; width:130px; height:130px; right:-44px; bottom:-58px; border-radius:999px; opacity:.16; background:currentColor; filter:blur(5px); }
    .house-symbol { width:48px; height:48px; display:grid; place-items:center; border-radius:16px; border:1px solid currentColor; background:rgba(255,255,255,.04); }
    .portal-view { display: none; animation: lift .34s ease both; }
    .portal-view.is-visible { display: block; }
    @keyframes lift { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
    .reveal { animation: reveal .6s ease both; }
    .delay-1 { animation-delay:.1s; } .delay-2 { animation-delay:.2s; } .delay-3 { animation-delay:.3s; }
    @keyframes reveal { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
    .detail-rule { position: relative; padding-left: 1.15rem; }
    .detail-rule::before { content:""; position:absolute; left:0; top:.58rem; width:.42rem; height:.42rem; border-radius:999px; background:currentColor; }
    .example-image { min-height: 260px; }
  </style>
  <script src="/_sdk/b3bf9e8ac58e6ad6.data_sdk.js" type="text/javascript" integrity="sha512-otc1u9NYq9Ms5Jt//7vmhrrqR5CLPr8Jdgs6741gqniClfLMcfmC+jK/cKuQdhLv6G0esJ/FzaMS9tv0T/vj/Q=="></script>
  <script src="/_sdk/a27879be4562f807.resizing_sdk.js" type="text/javascript" integrity="sha512-trcxRwz+QLrzK0Dqg95xqVRryR7WtWui2YopXyzOIr3WMde3j/xCRgT63/b/EAg7klDsAOuHzoRgoryhwm8QFw=="></script>
 </head>
 <body data-template-id="__page-root">
  <div class="portal-shell relative">
   <div class="star-field pointer-events-none absolute inset-0"></div>
   <header class="relative z-20 w-full border-b border-white/10">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-5 lg:px-8" aria-label="Navegação principal">
     <button id="brand-button" type="button" class="focus-ring flex items-center gap-3 rounded-lg text-left"> <span class="grid h-10 w-10 place-items-center rounded-xl border border-amber-300/35 bg-amber-400/10 text-amber-300"> <i data-lucide="sparkles" aria-hidden="true"></i> </span> <span data-template-id="nav-brand" class="canva-text text-sm font-bold uppercase tracking-[.18em]"></span> </button>
     <div class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
      <a data-template-id="nav-models" class="canva-link focus-ring rounded px-1 py-1 hover:text-white" href="#modelos"></a> <a data-template-id="nav-houses" class="canva-link focus-ring rounded px-1 py-1 hover:text-white" href="#casas"></a>
     </div>
    </nav>
   </header>
   <main class="relative z-10">
    <div id="library-view" class="portal-view is-visible">
     <section id="inicio" class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 lg:grid-cols-[1.05fr_.95fr] lg:px-8 lg:py-20">
      <div>
       <p data-template-id="hero-eyebrow" class="canva-text reveal mb-5 text-xs font-bold uppercase tracking-[.22em]"></p>
       <h1 data-template-id="hero-title" class="canva-text display-font reveal delay-1 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl"></h1>
       <p data-template-id="hero-description" class="canva-text reveal delay-2 mt-6 max-w-2xl text-lg leading-relaxed text-slate-300"></p>
       <div class="reveal delay-3 mt-9 flex flex-wrap gap-3">
        <a data-template-id="explore-button" class="canva-button focus-ring inline-flex items-center gap-2 rounded-xl px-5 py-3 font-bold transition hover:brightness-110" href="#modelos"><span data-template-id="explore-button-label" class="canva-text"></span><i data-lucide="arrow-down" class="h-4 w-4" aria-hidden="true"></i></a> <a data-template-id="houses-button" class="canva-button focus-ring inline-flex items-center gap-2 rounded-xl border px-5 py-3 font-semibold transition hover:bg-white/10" href="#casas"><span data-template-id="houses-button-label" class="canva-text"></span><i data-lucide="shield" class="h-4 w-4" aria-hidden="true"></i></a>
       </div>
      </div>
      <div data-template-id="houses-banner-panel" class="canva-panel glass-panel relative overflow-hidden rounded-3xl p-3">
       <img data-template-id="houses-banner-image" loading="lazy" class="canva-image h-auto w-full rounded-2xl object-cover">
       <div class="pointer-events-none absolute inset-x-3 bottom-3 rounded-b-2xl bg-gradient-to-t from-[#11161f]/85 to-transparent px-5 pb-5 pt-16">
        <p data-template-id="banner-caption" class="canva-text text-sm font-semibold"></p>
       </div>
      </div>
     </section>
     <section id="modelos" class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
       <div>
        <p data-template-id="models-eyebrow" class="canva-text text-xs font-bold uppercase tracking-[.22em]"></p>
        <h2 data-template-id="models-title" class="canva-text display-font mt-3 text-3xl font-semibold sm:text-4xl"></h2>
        <p data-template-id="models-note" class="canva-text mt-2 text-sm text-slate-400"></p>
       </div>
       <p data-template-id="models-helper" class="canva-text max-w-md text-sm leading-relaxed text-slate-400"></p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><button type="button" data-open-view="cliente" class="model-card focus-ring glass-panel rounded-2xl p-5 text-left"><span data-template-id="client-card-icon" class="canva-tag mb-5 inline-grid h-10 w-10 place-items-center rounded-xl"></span><p data-template-id="client-card-number" class="canva-text text-xs font-bold uppercase tracking-[.16em]"></p><h3 data-template-id="client-card-title" class="canva-text mt-3 font-bold"></h3><p data-template-id="client-card-description" class="canva-text mt-2 text-sm leading-relaxed text-slate-400"></p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold"><span data-template-id="client-card-cta" class="canva-text"></span><i data-lucide="arrow-right" class="h-4 w-4" aria-hidden="true"></i></span></button> <button type="button" data-open-view="interno" class="model-card focus-ring glass-panel rounded-2xl p-5 text-left"><span data-template-id="internal-card-icon" class="canva-tag mb-5 inline-grid h-10 w-10 place-items-center rounded-xl"></span><p data-template-id="internal-card-number" class="canva-text text-xs font-bold uppercase tracking-[.16em]"></p><h3 data-template-id="internal-card-title" class="canva-text mt-3 font-bold"></h3><p data-template-id="internal-card-description" class="canva-text mt-2 text-sm leading-relaxed text-slate-400"></p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold"><span data-template-id="internal-card-cta" class="canva-text"></span><i data-lucide="arrow-right" class="h-4 w-4" aria-hidden="true"></i></span></button> <button type="button" data-open-view="diretoria" class="model-card focus-ring glass-panel rounded-2xl p-5 text-left"><span data-template-id="board-card-icon" class="canva-tag mb-5 inline-grid h-10 w-10 place-items-center rounded-xl"></span><p data-template-id="board-card-number" class="canva-text text-xs font-bold uppercase tracking-[.16em]"></p><h3 data-template-id="board-card-title" class="canva-text mt-3 font-bold"></h3><p data-template-id="board-card-description" class="canva-text mt-2 text-sm leading-relaxed text-slate-400"></p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold"><span data-template-id="board-card-cta" class="canva-text"></span><i data-lucide="arrow-right" class="h-4 w-4" aria-hidden="true"></i></span></button> <button type="button" data-open-view="excel" class="model-card focus-ring glass-panel rounded-2xl p-5 text-left"><span data-template-id="excel-card-icon" class="canva-tag mb-5 inline-grid h-10 w-10 place-items-center rounded-xl"></span><p data-template-id="excel-card-number" class="canva-text text-xs font-bold uppercase tracking-[.16em]"></p><h3 data-template-id="excel-card-title" class="canva-text mt-3 font-bold"></h3><p data-template-id="excel-card-description" class="canva-text mt-2 text-sm leading-relaxed text-slate-400"></p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold"><span data-template-id="excel-card-cta" class="canva-text"></span><i data-lucide="arrow-right" class="h-4 w-4" aria-hidden="true"></i></span></button>
      </div>
