  <script src="/_sdk/489148d8756906ef.editing_sdk.js" integrity="sha512-hxxSbMNp1t+UEu3j/dIQUU4MJnmsCo0Gs3iQVVS706vrCJ3Yt2+ySOlfJEaPyiyQVLjZRmn1dNVqg6M40VZZHQ=="></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();

      const library = document.getElementById("library-view");
      const detailViews = document.querySelectorAll(".detail-view");

      function showLibrary() {
        detailViews.forEach((view) => view.classList.remove("is-visible"));
        library.classList.add("is-visible");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function showDetail(name) {
        library.classList.remove("is-visible");
        detailViews.forEach((view) => view.classList.remove("is-visible"));
        document.getElementById("detail-" + name).classList.add("is-visible");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      document.querySelectorAll("[data-open-view]").forEach((button) => {
        button.addEventListener("click", () => showDetail(button.dataset.openView));
      });

      document.querySelectorAll("[data-back]").forEach((button) => {
        button.addEventListener("click", showLibrary);
      });

      document.getElementById("brand-button").addEventListener("click", showLibrary);
    });
  </script>
 </body>
</html>
